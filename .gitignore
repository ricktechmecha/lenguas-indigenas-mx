# Secrets — never commit keys
.env
.env.*
*.key

# Generated audio
output_audio/
*.wav
*.mp3
*.m4a
*.aiff

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local agent tooling (private toolkit, not part of the project)
.devin/
_toolkit/

# OS
.DS_Store

# caché WALS regenerable (tools/build_language_profiles.py)
data/_wals/
# cachés regenerables de datos lingüísticos
data/_phoible/
data/_grambank/

# Datasets empaquetados para entrenamiento (regenerables con corpus_tool.py)
dataset/
# Audio del corpus comunitario (wavs reales = datos sensibles, nunca al repo)
corpus/*/wavs/
# Modelos entrenados (binarios grandes; se publican aparte)
models/

# excepción: audio de demo sí va al repo
!demo/demo_es.m4a
